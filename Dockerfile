ARG PYTHON_BASE=python:3.12.14-slim
FROM ${PYTHON_BASE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 BLACKBOX_POLICY_MODE=conservative
WORKDIR /app
COPY --chown=65534:65534 runtime/ /app/
USER 65534:65534
ENTRYPOINT ["python", "-B", "/app/policy.py", "--mode", "conservative"]
